# ==============================================================================
# DAV Application — Full Stack Environment Configuration
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change_this_to_a_secure_random_key_in_production
API_V1_STR=/api/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Comma-separated origins for web & mobile clients)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Connection (Default: SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./dav.db
# DATABASE_URL=postgresql+asyncpg://dav_user:dav_password@localhost:5432/dav_db

# Authentication & JWT
JWT_SECRET=change_to_a_secure_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OTP Service Configuration
# Provider options: mock (development default, uses 44444) | twilio (production SMS)
OTP_PROVIDER=mock
DEV_MOCK_OTP=44444
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Service Configuration (Google Gemini)
# Provider options: gemini (active when GEMINI_API_KEY is supplied) | mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Voice Service (STT / TTS) Configuration
VOICE_STT_PROVIDER=mock
VOICE_TTS_PROVIDER=mock
VOICE_API_KEY=

# Weather Service Configuration
# Supported providers: openmeteo (default free live weather) | openweathermap | mock
WEATHER_PROVIDER=openmeteo
OPENWEATHER_API_KEY=
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567
DEFAULT_LOCATION_NAME=Pune, MH
