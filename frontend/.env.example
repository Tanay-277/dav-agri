# ==============================================================================
# DAV Application — Frontend Environment Configuration (Vite + React)
# ==============================================================================

# Backend API Base URL
# Leave as a relative path so the app calls whichever origin served it.
# An absolute host would break on a phone (localhost = the phone itself).
# See docs/MOBILE.md.
VITE_API_BASE_URL=/api/v1

# Public Google OAuth Client ID (Safe for frontend exposure)
# NEVER put client secrets, database passwords, or Twilio tokens in frontend .env
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Leave EMPTY to use the development demo sign-in instead of real Google.
# Also set GOOGLE_CLIENT_ID in backend/.env to enable server-side verification;
# without it the backend cannot validate a real ID token.
VITE_GOOGLE_CLIENT_ID=
