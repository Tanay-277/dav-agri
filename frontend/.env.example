# ==============================================================================
# DAV Application — Frontend Environment Configuration (Vite + React)
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public Google OAuth Client ID (Safe for frontend exposure)
# NEVER put client secrets, database passwords, or Twilio tokens in frontend .env
VITE_GOOGLE_CLIENT_ID=
