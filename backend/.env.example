# --- App ---
APP_NAME=AgriStory Analytics API
ENV=development
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated) ---
# In production, set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data ---
DATASET_FILE=agriculture.csv
DATABASE_URL=sqlite:///agri.db

# --- Weather data ingestion ---
# Provider: csv | open-meteo | nasa-power (csv is default for MVRS)
WEATHER_PROVIDER=csv
OPEN_METEO_URL=https://archive-api.open-meteo.com/v1
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_API_TIMEOUT_S=10
WEATHER_CACHE_TTL_HOURS=24
WEATHER_FORECAST_CACHE_TTL_HOURS=3
WEATHER_API_MAX_RETRIES=3

# --- AI (Gemini) ---
# Leave empty to disable AI storytelling; rule-based engine is used as fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=false
